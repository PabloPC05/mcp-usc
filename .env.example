# Public, non-secret configuration.
USC_MOODLE_URL=https://cv.usc.es
USC_EXAM_SOURCES=https://www.usc.gal/gl/centro/REPLACE_ME
USC_HTTP_TIMEOUT=30

# Optional local academic profile for get_my_class_timetable. These values are
# read-only preferences; they never authenticate or write to USC. The degree
# URL must be an official USC degree page and course_number is 1..12.
# USC_ACADEMIC_DEGREE_URL=https://www.usc.gal/gl/estudos/graos/AREA/GRADO
# USC_ACADEMIC_COURSE_NUMBER=2
# USC_ACADEMIC_PROGRAM_ID=19955
# USC_ACADEMIC_GROUP_CODES=CLE_01;CLE_02
# USC_ACADEMIC_YEAR=2025/2026
# USC_ACADEMIC_SEMESTER=1
# USC_ACADEMIC_DATE_IN_WEEK=2026-02-16
# Alternatively, keep the same keys in a local JSON file and set:
# USC_ACADEMIC_PROFILE_FILE=C:\\Users\\REPLACE_ME\\mcp-usc-profile.json

# Anonymous public USC GET cache. Responses are cached only after strict schema
# validation. TTL/stale windows are seconds; size is the aggregate byte limit.
# usc.gal marks every page no-cache by default, so the TTL below is what decides
# freshness (0 disables the cache); only no-store responses are never kept.
USC_PUBLIC_CACHE_TTL_SECONDS=300
USC_PUBLIC_CACHE_STALE_IF_ERROR_SECONDS=3600
USC_PUBLIC_CACHE_MAX_ENTRIES=512
USC_PUBLIC_CACHE_MAX_BYTES=64000000

# Optional: use only a legitimately issued Moodle Web Services token.
# Prefer setting USC_MOODLE_TOKEN in your process environment or use a protected
# USC_MOODLE_TOKEN_FILE. Never commit either the token or that file.
# USC_MOODLE_TOKEN=
# USC_MOODLE_TOKEN_FILE=

# Optional assisted login bootstrap only. Runtime Campus queries always use HTTP
# (REST or MoodleSession/AJAX); Playwright is not used after login. To avoid it
# completely, import a session already opened in your browser with
# `mcp-usc import-session`. "auto" (default) uses the installed Chrome or Edge and
# falls back to Playwright's Chromium; "chromium", "chrome" or "msedge" force one.
USC_BROWSER_CHANNEL=auto

# MoodleSession is stored through keyring as `moodle-session` in the operating-
# system credential store (Credential Manager on Windows). It must never be
# copied into this file. The AJAX sesskey is fetched from /user/preferences.php and not persisted.

# HTTP mode (`mcp-usc serve --transport http`, Docker or Vercel). /mcp requires
# Authorization: Bearer <token>. Configure one verifier; the first one set wins:
# MCP_AUTH_TOKEN (at least 32 characters), MCP_AUTH_TOKEN_FILE (a file holding it)
# or MCP_AUTH_TOKEN_SHA256 (only its lowercase SHA-256 hex digest).
# MCP_AUTH_TOKEN=
# MCP_AUTH_TOKEN_FILE=
# MCP_AUTH_TOKEN_SHA256=
# MCP_USC_HOST=127.0.0.1
# MCP_USC_PORT=8000
# Writes over HTTP stay disabled unless this is true on a single persistent process
# (never on serverless platforms such as Vercel).
# MCP_USC_ALLOW_WRITES=false
# Shared key so several instances accept each other's read_course_resource
# references (needed on serverless; at least 32 random characters).
# MCP_USC_STATE_SECRET=

# Private USC credentials can be server secrets, but the HTTP endpoint also
# accepts X-USC-Moodle-Token or X-USC-Moodle-Session per request so that neither
# value needs to persist on the server. The REST token is preferred.
# USC_MOODLE_SESSION=

# Optional local allowlist for assignment uploads. Upload writes stay disabled
# until USC_UPLOAD_ROOT points to an existing directory. Only regular files
# resolved inside this directory are accepted (maximum 20 per operation).
# USC_UPLOAD_ROOT=C:\Users\REPLACE_ME\Documents\mcp-usc-uploads

# Per-file and aggregate upload limit in bytes. Default 50 MiB; accepted range
# is 1 byte through 100 MiB. This does not change Moodle's own smaller limits.
USC_MAX_UPLOAD_BYTES=52428800

# No environment variable bypasses previews, one-use confirmation tokens, or
# MCP host approval for writes. Read-only HTTP deployments publish only tools
# explicitly annotated as pure reads.
