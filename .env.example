# Public, non-secret configuration.
USC_MOODLE_URL=https://cv.usc.es
USC_EXAM_SOURCES=https://www.usc.gal/gl/centro/REPLACE_ME
USC_HTTP_TIMEOUT=30

# Anonymous public USC GET cache. Responses are cached only after strict schema
# validation. TTL/stale windows are seconds; size is the aggregate byte limit.
USC_PUBLIC_CACHE_TTL_SECONDS=300
USC_PUBLIC_CACHE_STALE_IF_ERROR_SECONDS=3600
USC_PUBLIC_CACHE_MAX_ENTRIES=128
USC_PUBLIC_CACHE_MAX_BYTES=64000000

# Optional: use only a legitimately issued Moodle Web Services token.
# Prefer setting USC_MOODLE_TOKEN in your process environment or use a protected
# USC_MOODLE_TOKEN_FILE. Never commit either the token or that file.
# USC_MOODLE_TOKEN=
# USC_MOODLE_TOKEN_FILE=

# Optional assisted login bootstrap only. Runtime Campus queries always use HTTP
# (REST or MoodleSession/AJAX); Playwright is not used after login. To avoid it
# completely, import a session already opened in your browser with
# `uv run mcp-usc import-session`. Empty/"chromium" uses Playwright's browser.
USC_BROWSER_CHANNEL=chromium

# MoodleSession is stored through keyring as `moodle-session` in the operating-
# system credential store (Credential Manager on Windows). It must never be
# copied into this file. The AJAX sesskey is fetched from /my/ and not persisted.

# Optional local allowlist for assignment uploads. Upload writes stay disabled
# until USC_UPLOAD_ROOT points to an existing directory. Only regular files
# resolved inside this directory are accepted (maximum 20 per operation).
# USC_UPLOAD_ROOT=C:\Users\REPLACE_ME\Documents\mcp-usc-uploads

# Per-file and aggregate upload limit in bytes. Default 50 MiB; accepted range
# is 1 byte through 100 MiB. This does not change Moodle's own smaller limits.
USC_MAX_UPLOAD_BYTES=52428800

# No environment variable bypasses previews, one-use confirmation tokens, or
# MCP host approval for writes. Never put MoodleSession or sesskey here.
